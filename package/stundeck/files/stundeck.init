#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled listen data_dir stun keepalive

	config_load stundeck
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get listen    main listen           "0.0.0.0:8080"
	config_get data_dir  main data_dir         "/etc/stundeck"
	config_get stun      main stun_server      "turn.cloudflare.com:3478"
	config_get keepalive main keepalive_server "www.cloudflare.com:80"

	mkdir -p "$data_dir"
	chmod 0700 "$data_dir"

	procd_open_instance stundeck
	procd_set_param command /usr/bin/stundeck
	procd_set_param env \
		STUNDECK_LISTEN="$listen" \
		STUNDECK_DATA_DIR="$data_dir" \
		STUNDECK_NATMAP_BINARY=/usr/bin/natmap \
		STUNDECK_NOTIFY_BINARY=/usr/bin/stundeck-notify \
		STUNDECK_STUN_SERVER="$stun" \
		STUNDECK_KEEPALIVE_SERVER="$keepalive"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "stundeck"
}
